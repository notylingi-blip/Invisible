    mbGroup.Size=UDim2.new(0,QW+20,0,QH+20)
    local defaultGroupPos=UDim2.new(1,-(QW+30),0.5,-(QH/2+10))
    mbGroup.Position=defaultGroupPos; MOBILE_DEFAULT_POS=defaultGroupPos
    mbGroup.BackgroundTransparency=1; mbGroup.BorderSizePixel=0; mbGroup.Active=true; mbGroup.ZIndex=100

    -- Safe mode overlay
    safeModeMobileOverlay=Instance.new("Frame",mbGroup); safeModeMobileOverlay.Size=UDim2.new(1,0,1,0)
    safeModeMobileOverlay.BackgroundColor3=Color3.fromRGB(200,220,255); safeModeMobileOverlay.BackgroundTransparency=0.4
    safeModeMobileOverlay.BorderSizePixel=0; safeModeMobileOverlay.ZIndex=200; safeModeMobileOverlay.Visible=false
    Instance.new("UICorner",safeModeMobileOverlay).CornerRadius=UDim.new(0,14)
    local safeLbl=Instance.new("TextLabel",safeModeMobileOverlay); safeLbl.Size=UDim2.new(1,0,1,0)
    safeLbl.BackgroundTransparency=1; safeLbl.Text="🔒"; safeLbl.TextColor3=C.textWhite
    safeLbl.Font=FONT_TITLE; safeLbl.TextSize=22; safeLbl.ZIndex=201

    task.spawn(function()
        task.wait(0.1); loadMobilePositions(); loadPerBtnPositions()
        for i,data in ipairs(mobileBtnFrames) do
            local key="g"..i
            if perBtnPositions[key] and data.frame and data.frame.Parent then
                data.frame.Position=UDim2.new(0,perBtnPositions[key].xo,0,perBtnPositions[key].yo)
            end
        end
        for _,data in ipairs(extraMobileFrames) do
            local key="e_"..data.key
            if perBtnPositions[key] and data.frame and data.frame.Parent then
                data.frame.Position=UDim2.new(0,perBtnPositions[key].xo,0,perBtnPositions[key].yo)
            end
        end
    end)

    local lastMobileSave=0
    mbGroup:GetPropertyChangedSignal("Position"):Connect(function()
        local t=tick(); if t-lastMobileSave>0.5 then lastMobileSave=t; saveMobilePositions() end
    end)

    -- Drag GROUP
    do
        local mbDrag,mbDragStart,mbStartPos=false,nil,nil
        mbGroup.InputBegan:Connect(function(inp)
            if State.mobileButtonLocked then return end
            if State.unlockPerButton then return end
            if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                mbDrag=true; mbDragStart=inp.Position; mbStartPos=mbGroup.Position
                inp.Changed:Connect(function() if inp.UserInputState==Enum.UserInputState.End then mbDrag=false end end)
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if not mbDrag then return end
            if inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch then
                local d=inp.Position-mbDragStart; mbGroup.Position=UDim2.new(mbStartPos.X.Scale,mbStartPos.X.Offset+d.X,mbStartPos.Y.Scale,mbStartPos.Y.Offset+d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then mbDrag=false end end)
    end

    -- Factory mobile button (TANPA UIStroke/outline)
    local function makeMobileBtn(label,col,row,isToggle,onAction)
        local relX=10+col*(QS+QG); local relY=10+row*(QS+QG)
        local frame=Instance.new("Frame",mbGroup)
        frame.Size=UDim2.new(0,QS,0,QS); frame.Position=UDim2.new(0,relX,0,relY)
        local btnIdx=#mobileBtnFrames+1
        table.insert(mobileBtnFrames,{frame=frame,col=col,row=row,idx=btnIdx})
        frame.BackgroundColor3=C.mbOff; frame.BorderSizePixel=0; frame.Active=true; frame.ZIndex=102
        -- Tidak ada UIStroke (no outline)
        local corner=Instance.new("UICorner",frame); corner.CornerRadius=UDim.new(0,10)
        local btn=Instance.new("TextButton",frame); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1
        btn.Text=label; btn.TextColor3=C.mbText; btn.Font=FONT_BOLD; btn.TextSize=10; btn.TextWrapped=true; btn.LineHeight=1.3
        btn.BorderSizePixel=0; btn.AutoButtonColor=false; btn.ZIndex=103
        local isOn=false
        local function applyState(on)
            TweenService:Create(frame,TweenInfo.new(0.15,Enum.EasingStyle.Quad),{BackgroundColor3=on and C.mbOn or C.mbOff}):Play()
            btn.TextColor3=on and C.mbTextOn or C.mbText
        end
        local perDragging=false; local perDragStart=nil; local perStartPos=nil; local perMoved=false
        btn.InputBegan:Connect(function(inp)
            if not State.unlockPerButton or State.mobileButtonLocked then return end
            if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                perDragging=true; perMoved=false; perDragStart=inp.Position; perStartPos=frame.Position
                inp.Changed:Connect(function() if inp.UserInputState==Enum.UserInputState.End then perDragging=false end end)
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if not perDragging then return end
            if inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch then
                local d=inp.Position-perDragStart
                if math.abs(d.X)>4 or math.abs(d.Y)>4 then perMoved=true end
                if perMoved then frame.Position=UDim2.new(0,perStartPos.X.Offset+d.X,0,perStartPos.Y.Offset+d.Y) end
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                if perDragging then perDragging=false; if perMoved then savePerBtnPositions() end end
            end
        end)
        btn.MouseButton1Click:Connect(function()
            if perMoved then perMoved=false; return end
            if isToggle then isOn=not isOn; applyState(isOn); if onAction then onAction(isOn) end
            else applyState(true); task.delay(0.2,function() applyState(false) end); if onAction then onAction() end end
        end)
        local function setter(s) isOn=s; applyState(s) end
        applyShapeToFrame(frame,State.mobileBtnShape)
        return frame, setter
    end

    -- Row 0: DROP | AUTO LEFT
    makeMobileBtn("DROP\nBR",0,0,false,function() if isSafeModeBlocked() then return end; runDropBrainrot() end)
    local _,setALfn=makeMobileBtn("AUTO\nLEFT",1,0,true,function(on)
        if on and isSafeModeBlocked() then task.delay(0.05,function() if setAL then setAL(false) end end); return end
        State.autoLeftEnabled=on; if autoLeftSetVisual then autoLeftSetVisual(on) end
        if on then if State.autoRightEnabled then stopAutoRight(); if setAR then setAR(false) end end; if State.batAimbotToggled then disableAimbot(); if aimbotSetVisual then aimbotSetVisual(false) end; if setAB then setAB(false) end end; startAutoLeft()
        else stopAutoLeft() end
    end); setAL=setALfn

    -- Row 1: BAT LOCK | AUTO RIGHT
    local _,setABfn=makeMobileBtn("BAT\nLOCK",0,1,true,function(on)
        if on and isSafeModeBlocked() then task.delay(0.05,function() if setAB then setAB(false) end end); return end
        if on then enableAimbot(); if aimbotSetVisual then aimbotSetVisual(true) end
        else disableAimbot(); if aimbotSetVisual then aimbotSetVisual(false) end end
    end); setAB=setABfn
    local _prevAU=_aimbotBtnUpdater
    _aimbotBtnUpdater=function(v) if _prevAU then _prevAU(v) end; setABfn(v) end
    local _,setARfn=makeMobileBtn("AUTO\nRIGHT",1,1,true,function(on)
        if on and isSafeModeBlocked() then task.delay(0.05,function() if setAR then setAR(false) end end); return end
        State.autoRightEnabled=on; if autoRightSetVisual then autoRightSetVisual(on) end
        if on then if State.autoLeftEnabled then stopAutoLeft(); if setAL then setAL(false) end end; if State.batAimbotToggled then disableAimbot(); if aimbotSetVisual then aimbotSetVisual(false) end; if setAB then setAB(false) end end; startAutoRight()
        else stopAutoRight() end
    end); setAR=setARfn

    -- Row 2: TP DOWN | CARRY SPD
    makeMobileBtn("TP\nDOWN",0,2,false,function() if isSafeModeBlocked() then return end; doTpDown() end)
    local _,setCarryMFn=makeMobileBtn("CARRY\nSPD",1,2,true,function(on)
        if on and isSafeModeBlocked() then task.delay(0.05,function() if setCarryMFn then setCarryMFn(false) end end); return end
        setCarryMode(on); if carryUpdaterRef then carryUpdaterRef(State.speedToggled) end
    end)

    -- Row 3: HOLD JUMP | LAGGER MODE
    makeMobileBtn("HOLD\nJUMP",0,3,true,function(on)
        if on and isSafeModeBlocked() then return end
        State.holdJumpEnabled=on; if on then startHoldJump() else stopHoldJump() end; saveSettings()
    end)
    local _,setLaggerMFn=makeMobileBtn("LAGGER\nMODE",1,3,true,function(on)
        if on and isSafeModeBlocked() then task.delay(0.05,function() if setLaggerMFn then setLaggerMFn(false) end end); return end
        setLaggerMode(on); if laggerUpdaterRef then laggerUpdaterRef(State.laggerEnabled) end
    end)

    -- Extra buttons (Row 4)
    local function makeExtraMobileBtn(label,col,btnKey,isToggle,onAction)
        local QS2=mobileBtnSize; local QG2=btnGap
        local relX=10+col*(QS2+QG2)
        local relY=10+4*(QS2+QG2)
        local frame=Instance.new("Frame",mbGroup)
        frame.Size=UDim2.new(0,QS2,0,QS2); frame.Position=UDim2.new(0,relX,0,relY)
        table.insert(extraMobileFrames,{frame=frame,col=col,row=4,key=btnKey})
