-- SPEED SYSTEM
local function startSpeedSystem()
    if Conns.speed then return end
    Conns.speed=RunService.RenderStepped:Connect(function()
        if State.batAimbotToggled or State.autoLeftEnabled or State.autoRightEnabled then return end
        local root=getHRP(); local hum=getHum(); if not root or not hum then return end
        local spd=State.laggerEnabled and State.laggerSpeed or (State.speedToggled and State.carrySpeed or State.normalSpeed)
        local md=hum.MoveDirection
        if md.Magnitude>0 then
            State.lastMoveDir=md
            root.Velocity=Vector3.new(md.X*spd,root.Velocity.Y,md.Z*spd)
        else
            local anyHeld=false
            for key in pairs(MOVE_KEYS) do if UIS:IsKeyDown(key) then anyHeld=true; break end end
            if anyHeld and State.lastMoveDir.Magnitude>0 then
                root.Velocity=Vector3.new(State.lastMoveDir.X*spd,root.Velocity.Y,State.lastMoveDir.Z*spd)
            end
        end
    end)
end
local function stopSpeedSystem() if Conns.speed then Conns.speed:Disconnect(); Conns.speed=nil end end
local function refreshSpeed() stopSpeedSystem(); startSpeedSystem() end

